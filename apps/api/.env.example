# API authentication key — must match NEXT_PUBLIC_API_KEY on the frontend.
# Leave empty to disable authentication (development mode).
API_SECRET_KEY=change-me-to-a-random-string

# Notification webhook (for live trading alerts)
NOTIFY_ENABLED=false
NOTIFY_WEBHOOK_URL=

# Risk controls
MAX_DRAWDOWN_HALT_RATIO=0.15
MAX_TRADES_PER_HOUR=5
MAX_TRADES_PER_DAY=20
